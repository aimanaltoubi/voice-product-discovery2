# Model settings. The pipeline is model agnostic - swap providers here
OPENAI_API_KEY=
LLM_PROVIDER=openai        # openai | anthropic | google_genai | ollama | mock (offline test)
LLM_MODEL=gpt-4o-mini
EMBEDDINGS_PROVIDER=local  # local (MiniLM) | openai | hash (offline test)
ASR_PROVIDER=local         # faster-whisper on this machine
TTS_PROVIDER=edge          # Microsoft Edge neural voices
WEB_SEARCH_PROVIDER=ddg    # ddg (keyless default) | openai (original-app parity) | serper | brave | tavily
